# App URLs
NEXT_PUBLIC_SITE_URL=https://eatlyte.app
NEXT_PUBLIC_APP_URL=https://eatlyte.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI food/photo/label scanning
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
DEEPSEEK_API_KEY=

# Food database expansion
USDA_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Open Food Facts does not require an API key for read/search.

# Invite emails: use resend or sendgrid
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
INVITE_FROM_EMAIL=Eatlyte <hello@mail.eatlyte.app>

# Optional monitoring
SENTRY_DSN=
